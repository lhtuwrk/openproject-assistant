{
  "manifest_version": 3,
  "name": "Backlog Monitor",
  "version": "1.6.0",
  "description": "Daily burndown snapshots, a time-log grid and a Jira-style skin for your OpenProject backlog.",

  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "notifications",
    "sidePanel",
    "scripting"
  ],

  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/reminder-banner.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/quick-settings-host.js"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16":  "icons/icon-16.png",
    "32":  "icons/icon-32.png",
    "48":  "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "options_page": "pages/dashboard.html",

  "side_panel": {
    "default_path": "pages/sidepanel.html"
  },

  "web_accessible_resources": [
    {
      "resources": ["pages/sidepanel.html"],
      "matches": ["http://*/*", "https://*/*"],
      "use_dynamic_url": true
    }
  ],

  "action": {
    "default_popup": "pages/popup.html",
    "default_title": "Backlog Monitor",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },

  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  }
}
